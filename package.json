{
  "name": "quakpit",
  "version": "0.1.0",
  "description": "Напоминание о встрече: утка на самолёте перелетает экран с баннером. Календари Google, iCloud, Exchange, iCal; интерфейс RU/EN. A duck in a plane flies across your screen towing a meeting-reminder banner. Google, iCloud, Exchange & iCal; RU/EN UI.",
  "author": "SergeiDos",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "gen:icons": "node scripts/generate-tray-icon.cjs && node scripts/generate-app-icon.cjs",
    "dev": "npm run gen:icons && electron-vite dev",
    "build": "npm run gen:icons && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "des.js": "^1.1.0",
    "ical.js": "^2.2.1",
    "js-md4": "^0.3.2"
  }
}
