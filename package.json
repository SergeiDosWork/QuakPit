{
  "name": "quakpit",
  "version": "0.1.0",
  "description": "Утка на самолёте пролетает по экрану с баннером-напоминанием о встрече. A little duck in a plane flies across your screen towing a banner that reminds you of your next meeting.",
  "author": "SergeiDos",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "gen:icons": "node scripts/generate-tray-icon.cjs && node scripts/generate-app-icon.cjs",
    "dev": "npm run gen:icons && electron-vite dev",
    "build": "npm run gen:icons && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "httpntlm": "^1.8.13",
    "ical.js": "^2.2.1"
  }
}
